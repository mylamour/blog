<!DOCTYPE html>

<% if (theme.home_background_scheme === 'light') {%>
  <html lang="<%= page.lang || page.language || config.language || 'zh-CN' %>" class="light page-<%= page.base ? page.base.replace(/\//g, '') : page.layout ? page.layout : 'home' %>">
<% } else { %>
  <html lang="<%= page.lang || page.language || config.language || 'zh-CN' %>" class="dark page-<%= page.base ? page.base.replace(/\//g, '') : page.layout ? page.layout : 'home' %>">
<% } %>

<head>
  <meta charset="utf-8">
  <script>(function(){var t=null;try{t=localStorage.getItem('theme')}catch(e){}if(t!=='light'&&t!=='dark'){t=window.matchMedia&&matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t)})();</script>
  <%
  var title = page.title;

  if (is_archive()){
    title = 'blog';

    if (is_month()){
      title += ': ' + page.year + '/' + page.month;
    } else if (is_year()){
      title += ': ' + page.year;
    }
  } else if (is_category()){
    title = 'Category: ' + page.category;
  } else if (is_tag()){
    title = 'Tag: ' + page.tag;
  }

  var canonicalUrl = page.permalink || full_url_for(page.canonical_path || page.path || path);
  canonicalUrl = canonicalUrl.replace(/\/index\.html$/, '/');

  var pageDescription = page.description || page.excerpt || page.content || config.description;
  if (pageDescription) {
    pageDescription = strip_html(pageDescription).replace(/\s+/g, ' ').trim().substring(0, 200);
  }

  function getTagNames(tags) {
    var names = [];
    if (tags && tags.length) {
      tags.forEach(function(tag) {
        names.push(tag.name || tag);
      });
    }
    return names;
  }
  %>
  <title><% if (title){ %><%= title %> | <% } %><%= config.title %></title>
  <link rel="canonical" href="<%= canonicalUrl %>">
  <% if (page.translated && config.alt_lang_url) {
    var altPath = (page.canonical_path || page.path || '').replace(/index\.html$/, '');
    var altUrl = config.alt_lang_url + '/' + altPath;
    var enUrl = (config.language === 'en') ? canonicalUrl : altUrl;
  %>
  <link rel="alternate" hreflang="<%= config.language || 'zh-CN' %>" href="<%= canonicalUrl %>">
  <link rel="alternate" hreflang="<%= config.alt_lang %>" href="<%= altUrl %>">
  <link rel="alternate" hreflang="x-default" href="<%= enUrl %>">
  <% } %>

  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">

  <% if (page.tags && page.tags.length) { %>
    <meta name="keywords" content="<% page.tags.forEach(function(tag) { %><%= tag.name %>,<% }); %>" />
  <% } else { %>
    <meta name="keywords" content="<%= theme.keywords %>" />
  <% } %>

  <%- open_graph({ url: canonicalUrl }) %>

  <% if (page.layout === 'post') {
    var tagNames = getTagNames(page.tags);
    var jsonLd = {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl
      },
      headline: page.title || config.title,
      description: pageDescription,
      url: canonicalUrl,
      datePublished: page.date && page.date.toISOString ? page.date.toISOString() : undefined,
      dateModified: page.updated && page.updated.toISOString ? page.updated.toISOString() : page.date && page.date.toISOString ? page.date.toISOString() : undefined,
      author: {
        '@type': 'Person',
        name: config.author || config.title
      },
      publisher: {
        '@type': 'Person',
        name: config.author || config.title
      },
      inLanguage: page.lang || page.language || config.language || 'zh-CN',
      keywords: tagNames.length ? tagNames.join(', ') : undefined
    };
  %>
    <script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script>
  <% } %>

  <% if (theme.rss){ %>
    <link rel="alternate" href="<%- theme.rss %>" title="<%= config.title %>" type="application/atom+xml">
  <% } %>

  <% if (theme.favicon){ %>
    <link rel="icon" href="<%- theme.favicon %>">
  <% } %>

  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <% if (theme.blog_name_font_familiy === 'FZShuSong') { %>
  <link rel="preload" href="/fonts/fzshusong-subset.woff2" as="font" type="font/woff2" crossorigin>
  <% } %>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/lxgw-wenkai-lite-webfont@1.7.0/lxgwwenkailite-regular.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.8/latin-400.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.8/latin-500.css">

  <%- partial('style') %>

  <link rel="stylesheet" href="/css/custom.css?v=8584cea1">

  <%- partial('google-analytics') %>
  <%- partial('baidu-analytics') %>
  <%- partial('baidu-push') %>

  <% if (theme.busuanzi && page.layout === 'post'){ %>
    <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
  <% } %>

</head>
