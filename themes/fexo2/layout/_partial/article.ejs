<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemprop="blogPost">
  <header class="article-header">
    <h1 class="post-title"><%= post.title || '(no title)' %></h1>

    <div class="article-meta">
      <span>
        <i class="icon-calendar"></i>
        <span><%= date(post.date, config.language === 'en' ? 'MMM D, YYYY' : 'YYYY.MM.DD') %></span>
      </span>

      <!-- <%- partial('component/category') %> -->
      
      <% if (config.author){ %>
        <span class="article-author">
          <i class="icon-user"></i>
          <span><%= config.author %></span>
        </span>
      <% } %>

      <%- partial('component/language-switch', { targetPage: post }) %>

      <% if (theme.count.wordcount){ %>
        <span class="post-count">
          <i class="icon-feather"></i>
          <span><%= wordcount(post.content) %><%= __('words') %></span>
        </span>
      <% } %>

      <% if (theme.count.readtime){ %>
        <span class="post-count">
          <span><%= __('readtime', min2read(post.content)) %></span>
        </span>
      <% } %>

      <% if (theme.busuanzi){ %>
        <span id="busuanzi_container_page_pv" style="display:none">
          <i class="icon-info-circled-1"></i>
          <% var visitsSuffix = __('visits_suffix'); %>
          <span><%= __('visits') %><span id="busuanzi_value_page_pv"></span><%= visitsSuffix === 'visits_suffix' ? '' : visitsSuffix %></span>
        </span>
      <% } %>

      <% if (theme.disqus_shortname && theme.url && page.comments){ %>
        <span>
          <i class="icon-comment"></i>
          <a href="<%= theme.url + url_for(page.path) + '#disqus_thread' %>"></a>
        </span>
      <% } %>

      
      <% if (theme.duoshuo_shortname){ %>
        <i class="icon-comment"></i> 
        <span class="ds-thread-count" data-thread-key="<%= page.layout %>-<%= page.slug %>"><i class="fa fa-spinner fa-spin"></i></span> 条评论
      <% } %>
      
    </div>
  </header>

  <div class="article-content">
    <% if (!index && post.layout === 'post' && post.date && post.date.year() < 2020 && !(post.tags && post.tags.toArray().some(function(t){ return t.name === '漫漫人生路'; }))) { %>
      <div class="stale-notice">
        <% if (config.language === 'en') { %>
          This post was written in <%= post.date.year() %>. Tools and versions mentioned may be outdated, though the underlying ideas still hold.
        <% } else { %>
          本文写于 <%= post.date.year() %> 年，文中涉及的工具与版本可能已过时，思路仍可参考。
        <% } %>
      </div>
    <% } %>
    <% if (post.excerpt && index){ %>
      <%- post.excerpt %>
      <% if (theme.excerpt_link){ %>
        <p class="article-more-link">
          <a class="btn btn-primary" href="<%- url_for(post.path) %>#more"><%= theme.excerpt_link %></a>
        </p>
      <% } %>
    <% } else { %>
      <%- post.content %>
    <% } %>
  </div>
</article>
