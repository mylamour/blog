<div class="content-home text-center">
  <a class="avatar" href="/">
    <picture>
      <% if (theme.avatar_webp) { %>
        <source srcset="<%= theme.avatar_webp %>" type="image/webp" />
      <% } %>
      <img src="<%= theme.avatar %>" alt="" />
    </picture>
  </a>
  <h1 class="name" style="font-family: <%= theme.blog_name_font_familiy || 'calligraffittiregular' %>">
    <%= theme.blog_name %>
  </h1>
  <% if (theme.author) { %>
    <h2 class="author">
      <%= theme.author %>
    </h2>
  <% } %>
  <div class="slogan">
    <%= theme.slogan %>
  </div>
  <%- partial('component/language-switch', { targetPage: page }) %>

  <hr>

  <ul class="text-center nav">
    <% theme.home_nav.forEach(function(item, i){ %>
      <li class="item">
        <% if(item.target_blank === true) { %>
          <i class="<%= item.icon %>"> </i>
          <a href="<%= item.url %>" rel="noopener noreferrer" target="_blank"><%= item.name %></a>
        <% } else { %>
          <i class="<%= item.icon %>"> </i>
          <a href="<%= item.url %>"><%= item.name %></a>
        <% } %>
        <span>|</span>
      </li>
    <% }) %>
  </ul>

  <% var recentPosts = site.posts.sort('date', -1).limit(3).toArray(); %>
  <% if (recentPosts.length) { %>
    <ul class="recent-posts">
      <% recentPosts.forEach(function(post){ %>
        <li>
          <a href="<%- url_for(post.path) %>"><%= post.title %></a>
          <span class="recent-posts-date"><%= date(post.date, config.language === 'en' ? 'MMM D, YYYY' : 'YYYY.MM.DD') %></span>
        </li>
      <% }) %>
    </ul>
  <% } %>

</div>
